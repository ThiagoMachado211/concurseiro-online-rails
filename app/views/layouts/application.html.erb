<!DOCTYPE html>
<html>
  <head>
    <title>Concurseiro Online</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>

    <header class="app-header">
      <div class="header-container">

        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">C</span>

          <span class="brand-text">
            Concurseiro
            <strong>Online</strong>
          </span>
        <% end %>

        <% if user_signed_in? %>

          <nav class="main-nav">
            <%= link_to "Questões",
                        questions_path,
                        class: "nav-link" %>

            <%= link_to "Meu desempenho",
                        history_path,
                        class: "nav-link" %>

            <% if current_user.admin? %>
              <%= link_to "Administração",
                          admin_root_path,
                          class: "nav-link" %>
            <% end %>
          </nav>

          <div class="user-area">
            <div class="user-info">
              <span class="user-name">
                <%= current_user.name %>
              </span>

              <span class="user-role">
                <%= current_user.admin? ? "Administrador" : "Aluno" %>
              </span>
            </div>

            <%= button_to "Sair",
                          destroy_user_session_path,
                          method: :delete,
                          class: "logout-button" %>
          </div>

        <% end %>

      </div>
    </header>


    <% if notice.present? %>
      <div class="flash-container">
        <div class="flash flash-success">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="flash-container">
        <div class="flash flash-alert">
          <%= alert %>
        </div>
      </div>
    <% end %>


    <main class="page-container">
      <%= yield %>
    </main>

  </body>
</html>